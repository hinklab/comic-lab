# ==============================================================================
# Comic Translation Studio - Environment Configuration (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE DATABASE PERSISTENCE (Free Tier PostgreSQL)
# Replaces growing local JSON files (mask_corrections, quality_gates, character_profiles, terminology)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://<your-project-id>.supabase.co
SUPABASE_KEY=<your-anon-or-service-role-key>

# ------------------------------------------------------------------------------
# 2. (OPTIONAL) GOOGLE CLOUD VISION OCR FALLBACK
# Activated ONLY when EasyOCR confidence is low (< 0.55).
# Hard cost-protection cap: 900 units/month (90% of 1,000 free-tier allowance).
# Leave blank to run 100% locally with EasyOCR.
# ------------------------------------------------------------------------------
GOOGLE_VISION_API_KEY=

# ------------------------------------------------------------------------------
# 3. (OPTIONAL) GOOGLE CLOUD TRANSLATION ADVISORY CROSS-CHECK
# Advisory cross-check only; does NOT replace local NLLB-200.
# Flags bubbles for human review if local NLLB and Google translations diverge.
# Hard cost-protection cap: 450,000 chars/month (90% of 500,000 free-tier allowance).
# Leave blank to disable cross-checking.
# ------------------------------------------------------------------------------
GOOGLE_TRANSLATE_API_KEY=

# ------------------------------------------------------------------------------
# 4. (OPTIONAL) MARVEL COMICS OFFICIAL API ENRICHMENT
# Standalone terminology enrichment tool (scripts/enrich_marvel_terminology.py).
# Not part of per-page pipeline. Read-only suggestions for human approval.
# Free-tier allowance: 3,000 requests/day. Hard cap: 2,700 requests/day.
# Get free keys at: https://developer.marvel.com
# ------------------------------------------------------------------------------
MARVEL_PUBLIC_KEY=
MARVEL_PRIVATE_KEY=
