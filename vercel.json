{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://YOUR_HF_SPACE_URL.hf.space/api/:path*"
    },
    {
      "source": "/",
      "destination": "/web/index.html"
    },
    {
      "source": "/static/:path*",
      "destination": "/web/:path*"
    }
  ]
}
